# =============================================================================
# Exemplo para deploy Coolify — copie para .env no servidor/UI (NÃO commite .env)
# =============================================================================
# Ver guia completo: docs/migracao-railway-coolify.md

# --- Opção compose (docker-compose.coolify.yml) ---
POSTGRES_USER=gti
POSTGRES_PASSWORD=trocar-por-segredo-forte
POSTGRES_DB=gti_contratos
APP_PORT=3000

# --- Opção Postgres separado no Coolify: use só DATABASE_URL ---
# URL interna entre serviços na rede Docker do Coolify (ajuste host/user/pass):
DATABASE_URL="postgresql://gti:trocar-por-segredo-forte@postgres:5432/gti_contratos?schema=public"

# JWT (mesmo valor que tinha na Railway para não invalidar sessões durante migração)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Resend (opcional)
# RESEND_API_KEY=
# RESEND_FROM="GTI <gti@exemplo.gov.br>"

# GLPI — obrigatório
GLPI_BASE_URL=https://suporte.exemplo.gov.br/api.php
NEXT_PUBLIC_GLPI_BASE_URL=https://suporte.exemplo.gov.br/api.php
GLPI_DOC_URL=https://suporte.exemplo.gov.br/api.php/v2.2.0/doc.json
GLPI_TICKETS_PATH=/v2/Assistance/Ticket
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_OAUTH_SCOPE=api
GLPI_USER_AGENT=glpi-sync-mvp/1.0

CRON_EXPRESSION=*/5 * * * *
HTTP_TIMEOUT_MS=20000

# Anexos — caminho absoluto no contentor (volume persistente Coolify)
UPLOAD_ROOT=/app/apps/frontend/uploads
# UPLOAD_MAX_MB=10

# Produção com base importada da Railway: evita wipe automático se houver drift de migrações
# PRISMA_NO_AUTO_WIPE_ON_LEGACY_DRIFT=1

# Opcional: desligar cron no processo web se tiver worker dedicado
# GLPI_CRON_DISABLED=1

# --- Só para scripts de migração db-export.sh (máquina local, ficheiro .env.migracao) ---
# RAILWAY_DATABASE_URL="postgresql://...railway...?sslmode=require"
# COOLIFY_DATABASE_URL="postgresql://...coolify..."

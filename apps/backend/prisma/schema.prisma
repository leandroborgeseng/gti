model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  /// CPF somente dígitos (11). Opcional em legado; obrigatório em novos cadastros.
  cpf                 String?              @unique
  firstName           String?
  lastName            String?
  displayName         String?
  profileColor        String?
  jobTitle            String?
  department          String?
  phone               String?
  /// Órgão principal do usuário (legado; sincronizado com o vínculo padrão).
  organizationId      String?              @map("organization_id")
  /// Quando true, o usuário pode atuar com visão «Todos os órgãos».
  allOrganizations    Boolean              @default(false) @map("all_organizations")
  /// Último perfil ativo na sessão (contexto).
  lastActiveProfileId String?              @map("last_active_profile_id")
  /// Último órgão ativo; null + allOrganizations = Todos os órgãos.
  lastActiveOrganizationId String?         @map("last_active_organization_id")
  /// Perfil padrão ao login (quando lastActive não for válido).
  defaultProfileId    String?              @map("default_profile_id")
  /// Órgão padrão; null + allOrganizations = Todos.
  defaultOrganizationId String?            @map("default_organization_id")
  passwordHash        String
  mustChangePassword  Boolean              @default(false)
  approvalStatus      UserApprovalStatus   @default(APPROVED)
  /// Justificativa administrativa quando o cadastro é recusado (não exclui a solicitação).
  approvalRejectionReason String?          @map("approval_rejection_reason") @db.Text
  /// Papel legado; sincronizado com o systemKey do perfil padrão.
  role                UserRole             @default(EDITOR)
  /// Conta interna (servidor) ou externa (empresa).
  userKind            UserKind             @default(INTERNAL) @map("user_kind")
  /// Fornecedor ao qual o usuário externo pertence.
  supplierId          String?              @map("supplier_id")
  /// Função do usuário externo.
  externalFunction    ExternalUserFunction? @map("external_function")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization?        @relation("UserPrimaryOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  lastActiveProfile   AccessProfile?       @relation("UserLastActiveProfile", fields: [lastActiveProfileId], references: [id], onDelete: SetNull)
  lastActiveOrganization Organization?     @relation("UserLastActiveOrganization", fields: [lastActiveOrganizationId], references: [id], onDelete: SetNull)
  defaultProfile      AccessProfile?       @relation("UserDefaultProfile", fields: [defaultProfileId], references: [id], onDelete: SetNull)
  defaultOrganization Organization?        @relation("UserDefaultOrganization", fields: [defaultOrganizationId], references: [id], onDelete: SetNull)
  supplier            Supplier?            @relation("UserExternalSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  accessProfiles      UserAccessProfile[]
  organizations       UserOrganization[]
  externalContracts   UserExternalContract[]
  passwordResetTokens PasswordResetToken[]
  supervisedProjects  Project[]            @relation("ProjectSupervisor")
  validatedContractModules ContractModule[] @relation("ContractModuleValidator")
  moduleFiscalLinks   ContractModuleFiscal[] @relation("ContractModuleFiscalUser")
  featureResponsibleLinks ContractFeatureResponsible[] @relation("ContractFeatureResponsibleUser")
  validationGroupMemberships ContractValidationGroupMember[] @relation("ContractValidationGroupMemberUser")
  scheduleResponsibleLinks ContractScheduleInternalResponsible[] @relation("ContractScheduleInternalResponsibleUser")
  scheduleMilestoneResponsibleLinks ContractScheduleMilestoneInternalResponsible[] @relation("ContractScheduleMilestoneInternalResponsibleUser")
  occurrenceResponsibleLinks ContractOccurrence[] @relation("ContractOccurrenceInternalResponsible")
  deadlineResponsibleLinks Deadline[] @relation("DeadlineResponsibleUser")
  accessEvents        UserAccessEvent[]
  fiscalProfile       Fiscal?              @relation("FiscalUser")
  projectTaskComments ProjectTaskComment[]  @relation("ProjectTaskCommentAuthor")
  assignedProjectTasks ProjectTask[]         @relation("ProjectTaskAssignee")
  responsibleProjectTasks ProjectTaskResponsible[]
  extraPermissions    UserPermission[]
  createdNotifications ContractNotification[] @relation("ContractNotificationCreatedBy")
  notificationSignatures ContractNotificationSigner[] @relation("ContractNotificationSignerUser")
  notificationResponses ContractNotificationResponse[] @relation("ContractNotificationResponseAuthor")

  @@index([organizationId])
  @@index([lastActiveProfileId])
  @@index([lastActiveOrganizationId])
  @@index([defaultProfileId])
  @@index([defaultOrganizationId])
  @@index([userKind])
  @@index([supplierId])
}

/// Perfil de acesso dinâmico (Administrador/Editor/Leitor do sistema + perfis customizados).
model AccessProfile {
  id             String              @id @default(uuid())
  name           String
  description    String?
  active         Boolean             @default(true)
  nameNormalized String              @unique @map("name_normalized")
  /// ADMIN | EDITOR | VIEWER para os três perfis de sistema protegidos.
  systemKey      String?             @unique @map("system_key")
  protected      Boolean             @default(false)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  userLinks      UserAccessProfile[]
  userPermissions UserPermission[]
  usersLastActive User[]             @relation("UserLastActiveProfile")
  usersDefault    User[]             @relation("UserDefaultProfile")

  @@map("access_profile")
}

/// Vínculo N:N usuário ↔ perfil de acesso.
model UserAccessProfile {
  userId    String        @map("user_id")
  profileId String        @map("profile_id")
  isDefault Boolean       @default(false) @map("is_default")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   AccessProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@id([userId, profileId])
  @@index([profileId])
  @@map("user_access_profile")
}

/// Vínculo N:N usuário ↔ órgão.
model UserOrganization {
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("user_organization")
}

model UserAccessEvent {
  id              String   @id @default(uuid())
  userId          String?
  userEmail       String
  eventType       String
  path            String?
  pathLabel       String?
  sessionId       String?
  durationSeconds Int      @default(0)
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([userEmail, occurredAt])
  @@index([eventType, occurredAt])
  @@index([path, occurredAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  cnpj      String     @unique
  /// Contatos adicionais para envio de notificações (JSON: [{name,email,role?}]).
  contacts  Json?
  contracts Contract[]
  externalUsers User[] @relation("UserExternalSupplier")
}

/// Contratos autorizados para um usuário externo (mesmo fornecedor).
model UserExternalContract {
  userId     String   @map("user_id")
  contractId String   @map("contract_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@id([userId, contractId])
  @@index([contractId])
  @@map("user_external_contract")
}

model Fiscal {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  phone             String
  userId            String?    @unique
  user              User?      @relation("FiscalUser", fields: [userId], references: [id], onDelete: SetNull)
  contractsAsFiscal Contract[] @relation("ContractFiscal")
  contractsAsManager Contract[] @relation("ContractManager")
}

model Contract {
  id               String             @id @default(uuid())
  /// Identificação completa número/ano (ex.: 370/2022). Mantida para compatibilidade e unicidade.
  number           String             @unique
  /// Número formal sem ano (ex.: 370 ou 0156).
  formalNumber     String?            @map("formal_number")
  /// Ano derivado da vigência (preenchido automaticamente).
  contractYear     Int?               @map("contract_year")
  /// Código interno imutável SIGTI (ex.: ST-2026-001).
  internalCode     String?            @unique @map("internal_code")
  /// Processo administrativo (ex.: 23.911/2022).
  administrativeProcess String?       @map("administrative_process")
  name             String
  description      String?
  /// Texto legado de órgão gestor (preservado na migração).
  managingUnit     String?
  /// Órgão gestor vinculado ao cadastro central.
  organizationId   String?            @map("organization_id")
  /// Quando true, órgão legado ainda não foi vinculado com segurança.
  organizationPending Boolean         @default(false) @map("organization_pending")
  companyName      String
  cnpj             String
  /// Enum legado (mantido sincronizado com o catálogo).
  contractType     ContractType
  /// Tipo de contrato do cadastro Administração.
  contractTypeCatalogId String?       @map("contract_type_catalog_id")
  /// Tipo/modalidade de contratação (pregão, dispensa…).
  hiringTypeId     String?            @map("hiring_type_id")
  /// Número e ano do procedimento (ex.: 0156/2022).
  hiringProcedureNumber String?       @map("hiring_procedure_number")
  lawType          LawType
  startDate        DateTime
  endDate          DateTime
  totalValue       Decimal            @db.Decimal(18, 2)
  monthlyValue     Decimal            @db.Decimal(18, 2)
  /// Valor de implantação (único / projeto), separado da mensalidade.
  installationValue Decimal?          @db.Decimal(18, 2)
  /// Valor global original (12 meses / vigência na contratação).
  globalValueOriginal Decimal?        @map("global_value_original") @db.Decimal(18, 2)
  /// Valor global vigente (após aditivos/reajustes).
  globalValueCurrent  Decimal?        @map("global_value_current") @db.Decimal(18, 2)
  /// Valor global informado manualmente (exceção).
  globalValueManual   Boolean         @default(false) @map("global_value_manual")
  globalValueJustification String?    @map("global_value_justification") @db.Text
  /// Início do período em que predomina a cobrança/referência da implantação (data civil).
  implementationPeriodStart DateTime?
  /// Fim do período de implantação; após esta data considera-se a fase de mensalidade proporcional.
  implementationPeriodEnd   DateTime?
  status           ContractStatus
  slaTarget        Decimal?           @db.Decimal(5, 2)
  fiscalId         String
  managerId        String
  supplierId       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  organization     Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contractTypeCatalog ContractTypeCatalog? @relation(fields: [contractTypeCatalogId], references: [id], onDelete: SetNull)
  hiringType       HiringType?        @relation(fields: [hiringTypeId], references: [id], onDelete: SetNull)
  fiscal           Fiscal             @relation("ContractFiscal", fields: [fiscalId], references: [id])
  manager          Fiscal             @relation("ContractManager", fields: [managerId], references: [id])
  supplier         Supplier?          @relation(fields: [supplierId], references: [id])
  modules          ContractModule[]
  services         ContractService[]
  measurements     Measurement[]
  governanceTickets TicketGovernance[]
  amendments        ContractAmendment[]
  /** Grupos GLPI atribuídos aos chamados (alinhado a `Ticket.contractGroupId`) para métricas de SLA por contrato. */
  glpiGroups        ContractGlpiGroup[]
  /** Grupos de validação de entrega das funcionalidades do contrato. */
  validationGroups ContractValidationGroup[]
  /** Histórico auditável de inserção, exclusão e mudança de status dos itens contratuais. */
  itemChangeLogs ContractItemChangeLog[]
  /** Itens de precificação dinâmica (mensalidade, horas, UST, equipamentos, etc.). */
  pricingItems   ContractPricingItem[]
  /** Cronogramas e marcos operacionais do contrato. */
  schedules      ContractSchedule[]
  /** Ocorrências contratuais (ticket 47). */
  occurrences  ContractOccurrence[]
  /** Dossiês encaminhados à Controladoria (ticket 48). */
  controladoriaCases ContractControladoriaCase[]
  /** Prazos e alertas materializados (tickets 49/51/58). */
  deadlines    Deadline[]
  /** Usuários externos autorizados neste contrato. */
  externalUserLinks UserExternalContract[]
  /** Notificações formais do contrato. */
  notifications ContractNotification[]
  /** Classificação contratual local de chamados GLPI. */
  glpiTicketClasses ContractGlpiTicketClass[]
  /** Movimentações de consumo (horas, UST, etc.). */
  consumptionMovements ContractConsumptionMovement[]

  @@index([status, endDate])
  @@index([deletedAt])
  @@index([organizationId])
  @@index([formalNumber, contractYear])
  @@index([internalCode])
}

model ContractItemChangeLog {
  id                   String                   @id @default(uuid())
  contractId           String
  itemType             ContractItemChangeType
  itemId               String?
  itemName             String
  action               ContractItemChangeAction
  criticalityBefore    String?
  criticalityAfter     String?
  statusBefore         String?
  statusAfter          String?
  deliveryStatusBefore String?
  deliveryStatusAfter  String?
  actorId              String?
  actorLabel           String?
  changedAt            DateTime                 @default(now())
  oldData              Json?
  newData              Json?
  contract             Contract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, changedAt])
  @@index([itemType, itemId])
  @@index([action, changedAt])
}

/// Liga um contrato a um ou mais grupos de trabalho do GLPI (ID do grupo na instância sincronizada).
model ContractGlpiGroup {
  id            String   @id @default(uuid())
  contractId    String
  glpiGroupId   Int
  glpiGroupName String?
  createdAt     DateTime @default(now())
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, glpiGroupId])
  @@index([glpiGroupId])
}

/// Registro de aditivo/reajuste/repactuação (histórico contratual e financeiro).
model ContractAmendment {
  id                   String                   @id @default(uuid())
  contractId           String
  type                 ContractAmendmentType    @default(OUTRO)
  status               ContractAmendmentStatus  @default(ACTIVE)
  referenceCode        String?
  /// Data de formalização do instrumento (assinatura/publicação).
  formalizationDate    DateTime?
  /// Início dos efeitos financeiros/contratuais (legado e API: effectiveDate / effectsStartDate).
  effectiveDate        DateTime
  description          String
  previousTotalValue   Decimal                  @db.Decimal(18, 2)
  previousMonthlyValue Decimal                  @db.Decimal(18, 2)
  previousEndDate      DateTime
  previousGlobalValue  Decimal?                 @map("previous_global_value") @db.Decimal(18, 2)
  newTotalValue        Decimal?                 @db.Decimal(18, 2)
  newMonthlyValue      Decimal?                 @db.Decimal(18, 2)
  newEndDate           DateTime?
  newGlobalValue       Decimal?                 @map("new_global_value") @db.Decimal(18, 2)
  adjustmentPercent    Decimal?                 @map("adjustment_percent") @db.Decimal(9, 4)
  indexReference       String?                  @map("index_reference")
  cancelJustification  String?                  @map("cancel_justification") @db.Text
  cancelledAt          DateTime?                @map("cancelled_at")
  actorId              String?                  @map("actor_id")
  actorLabel           String?                  @map("actor_label")
  createdAt            DateTime                 @default(now())

  contract Contract                 @relation(fields: [contractId], references: [id], onDelete: Restrict)
  items    ContractAmendmentItem[]

  @@index([contractId, createdAt])
  @@index([contractId, effectiveDate])
  @@index([status])
}

/// Item afetado por um aditivo (criação, atualização com versionamento ou supressão).
model ContractAmendmentItem {
  id                  String                       @id @default(uuid())
  amendmentId         String                       @map("amendment_id")
  /// Item de precificação de origem (UPDATE/SUPPRESS); nulo em CREATE puro.
  pricingItemId       String?                      @map("pricing_item_id")
  /// Item resultante após CREATE/UPDATE (nova versão ACTIVE).
  resultPricingItemId String?                      @map("result_pricing_item_id")
  action              ContractAmendmentItemAction
  adjustmentPercent   Decimal?                     @map("adjustment_percent") @db.Decimal(9, 4)
  beforeSnapshot      Json?                        @map("before_snapshot")
  afterSnapshot       Json?                        @map("after_snapshot")
  createdAt           DateTime                     @default(now()) @map("created_at")

  amendment ContractAmendment @relation(fields: [amendmentId], references: [id], onDelete: Cascade)

  @@index([amendmentId])
  @@index([pricingItemId])
  @@map("contract_amendment_item")
}

model ContractModule {
  id                 String                  @id @default(uuid())
  contractId         String
  name               String
  criticality        ContractItemCriticality @default(MEDIA) @map("modulo_criticidade")
  /// Legado (um fiscal). Mantido sincronizado com o primeiro vínculo em `fiscals`.
  validatorId        String?                 @map("fiscal_responsavel_id")
  glosaPricingItemId String?                 @map("glosa_pricing_item_id")
  weight             Decimal                 @db.Decimal(18, 8)
  contract           Contract                @relation(fields: [contractId], references: [id], onDelete: Restrict)
  validator          User?                   @relation("ContractModuleValidator", fields: [validatorId], references: [id], onDelete: SetNull)
  glosaPricingItem   ContractPricingItem?    @relation("ContractModuleGlosaPricingItem", fields: [glosaPricingItemId], references: [id], onDelete: SetNull)
  features           ContractFeature[]
  fiscals            ContractModuleFiscal[]

  @@index([contractId])
  @@index([validatorId])
  @@index([glosaPricingItemId])
}

/// Fiscais responsáveis pelo módulo (N:N). Substitui gradualmente o uso exclusivo de `validatorId`.
model ContractModuleFiscal {
  moduleId  String
  userId    String
  createdAt DateTime       @default(now())
  module    ContractModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user      User           @relation("ContractModuleFiscalUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([moduleId, userId])
  @@index([userId])
}

/// Grupo de validação do contrato: membros responsáveis pela validação das funcionalidades vinculadas.
model ContractValidationGroup {
  id          String   @id @default(uuid())
  contractId  String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  members     ContractValidationGroupMember[]
  features    ContractFeature[]

  @@index([contractId, active])
  @@index([contractId, name])
}

/// Membros (usuários) de um grupo de validação. Podem ser de outros órgãos.
model ContractValidationGroupMember {
  groupId   String
  userId    String
  createdAt DateTime                @default(now())
  group     ContractValidationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User                    @relation("ContractValidationGroupMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model ContractFeature {
  id                     String                     @id @default(uuid())
  moduleId               String
  itemCode               String?                    @map("funcionalidade_codigo")
  name                   String
  criticality            ContractItemCriticality    @default(MEDIA) @map("funcionalidade_criticidade")
  weight                 Decimal                    @db.Decimal(18, 8)
  status                 ContractFeatureStatus      @default(NOT_STARTED)
  deliveryStatus         ContractItemDeliveryStatus @default(NOT_DELIVERED)
  /// Data efetiva vigente da entrega (espelho do último evento ACTIVE).
  deliveryEffectiveDate  DateTime?                  @map("delivery_effective_date") @db.Date
  /// Percentual acumulado vigente (5–95) quando parcial; null nos demais estados.
  partialDeliveryPercent Int?                       @map("partial_delivery_percent")
  /// Grupo de validação (obrigatório em novos itens; nullable para legado).
  validationGroupId      String?                    @map("validation_group_id")
  module                 ContractModule             @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  validationGroup        ContractValidationGroup?   @relation(fields: [validationGroupId], references: [id], onDelete: Restrict)
  responsibles           ContractFeatureResponsible[]
  scheduleMilestones     ContractScheduleMilestone[]
  deliveryEvents         ContractFeatureDeliveryEvent[]

  @@index([validationGroupId])
  @@index([deliveryStatus, deliveryEffectiveDate])
}

/// Evento imutável do histórico temporal de entrega (ticket 96).
enum ContractFeatureDeliveryEventStatus {
  ACTIVE
  ANNULLED
}

model ContractFeatureDeliveryEvent {
  id               String                             @id @default(uuid())
  featureId        String
  /// Data em que o percentual/estado passou a valer (não a data do registro no SIGTI).
  effectiveDate    DateTime                           @db.Date
  deliveryStatus   ContractItemDeliveryStatus
  /// 0 (não entregue), 5–95 (parcial), 100 (entregue).
  percent          Int
  note             String?
  status           ContractFeatureDeliveryEventStatus @default(ACTIVE)
  recordedAt       DateTime                           @default(now())
  actorId          String?
  actorLabel       String?
  annulledAt       DateTime?
  annulledById     String?
  annulledByLabel  String?
  annulReason      String?
  feature          ContractFeature                    @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@index([featureId, effectiveDate])
  @@index([featureId, status, effectiveDate])
}

/// Responsáveis específicos do item/funcionalidade. Complementam (não substituem) os membros do grupo de validação.
model ContractFeatureResponsible {
  featureId String
  userId    String
  createdAt DateTime        @default(now())
  feature   ContractFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  user      User            @relation("ContractFeatureResponsibleUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([featureId, userId])
  @@index([userId])
}

model ContractService {
  id         String   @id @default(uuid())
  contractId String
  name       String
  unit       String
  unitValue  Decimal  @db.Decimal(18, 4)
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
}

model Measurement {
  id                 String             @id @default(uuid())
  contractId         String
  referenceMonth     Int
  referenceYear      Int
  status             MeasurementStatus  @default(OPEN)
  totalMeasuredValue Decimal            @default(0) @db.Decimal(18, 2)
  totalApprovedValue Decimal            @default(0) @db.Decimal(18, 2)
  totalGlosedValue   Decimal            @default(0) @db.Decimal(18, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  contract           Contract           @relation(fields: [contractId], references: [id], onDelete: Restrict)
  items              MeasurementItem[]
  glosas             Glosa[]
  attachments        Attachment[]

  @@unique([contractId, referenceMonth, referenceYear])
  @@index([deletedAt, status])
  @@index([status, referenceYear, referenceMonth])
}

model MeasurementItem {
  id              String              @id @default(uuid())
  measurementId   String
  type            MeasurementItemType
  referenceId     String
  /// Item de precificação medido (quando aplicável).
  pricingItemId   String?             @map("pricing_item_id")
  quantity        Decimal             @db.Decimal(18, 4)
  calculatedValue Decimal             @db.Decimal(18, 2)
  /// Snapshot da descrição do item contratual na composição da medição.
  descriptionSnapshot String?         @map("description_snapshot") @db.Text
  /// Snapshot do valor unitário usado no cálculo.
  unitValueSnapshot   Decimal?        @map("unit_value_snapshot") @db.Decimal(18, 4)
  billingKindSnapshot ContractPricingBillingKind? @map("billing_kind_snapshot")
  periodicitySnapshot ContractPricingPeriodicity? @map("periodicity_snapshot")
  /// Período efetivo da linha dentro da competência (split por mudança no mês).
  coverageStart   DateTime?           @map("coverage_start")
  coverageEnd     DateTime?           @map("coverage_end")
  /// Memória de cálculo (dias, proporção, fórmula, etc.).
  calculationMemory Json?             @map("calculation_memory")
  /// Linha legada gerada a partir de monthlyValue sem item equivalente.
  isLegacyMonthly Boolean             @default(false) @map("is_legacy_monthly")
  /// Soma de glosas associadas a esta linha (informativo).
  glosedValue     Decimal             @default(0) @map("glosed_value") @db.Decimal(18, 2)
  measurement     Measurement         @relation(fields: [measurementId], references: [id], onDelete: Restrict)
  pricingItem     ContractPricingItem? @relation(fields: [pricingItemId], references: [id], onDelete: SetNull)
  glosas          Glosa[]

  @@index([measurementId])
  @@index([pricingItemId])
}

model Glosa {
  id                String      @id @default(uuid())
  measurementId     String
  /// Linha da medição à qual a glosa se refere (opcional).
  measurementItemId String?     @map("measurement_item_id")
  type              GlosaType
  origin            GlosaOrigin @default(MANUAL)
  value             Decimal     @db.Decimal(18, 2)
  justification     String
  createdBy         String
  createdAt         DateTime    @default(now())
  measurement       Measurement @relation(fields: [measurementId], references: [id], onDelete: Restrict)
  measurementItem   MeasurementItem? @relation(fields: [measurementItemId], references: [id], onDelete: SetNull)
  attachments       Attachment[]

  @@index([measurementItemId])
  @@index([measurementId, origin])
}

model AuditLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  action    String
  userId    String
  timestamp DateTime @default(now())
  oldData   Json?
  newData   Json?

  @@index([timestamp])
  @@index([entity, entityId])
  @@index([userId, timestamp])
  @@index([action, timestamp])
}

model OperationalEvent {
  id          String   @id @default(uuid())
  type        String
  category    String
  entity      String
  entityId    String?
  title       String
  description String?
  actorId     String?
  actorLabel  String?
  occurredAt  DateTime @default(now())
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([occurredAt])
  @@index([category, occurredAt])
  @@index([entity, entityId])
  @@index([type, occurredAt])
}

model TicketGovernance {
  id                     String                 @id @default(uuid())
  ticketId               String
  contractId             String
  openedAt               DateTime
  acknowledgedAt         DateTime?
  priority               GovernancePriority?
  type                   GovernanceType?
  slaDeadline            DateTime?
  firstResponseAt        DateTime?
  resolvedAt             DateTime?
  status                 TicketGovernanceStatus @default(OPEN)
  managerNotified        Boolean                @default(false)
  controladoriaNotified  Boolean                @default(false)
  seiProcessNumber       String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  contract               Contract               @relation(fields: [contractId], references: [id], onDelete: Restrict)
  deadlineExtensions     TicketDeadlineExtension[]
  eventLogs              TicketEventLog[]
  watchers               TicketWatcher[]

  @@index([ticketId])
  @@index([contractId])
  @@index([status, slaDeadline])
}

model TicketDeadlineExtension {
  id                 String           @id @default(uuid())
  ticketGovernanceId String
  previousDeadline   DateTime
  newDeadline        DateTime
  justification      String
  createdBy          String
  createdAt          DateTime         @default(now())
  ticketGovernance   TicketGovernance @relation(fields: [ticketGovernanceId], references: [id], onDelete: Restrict)
}

model TicketEventLog {
  id                 String           @id @default(uuid())
  ticketGovernanceId String
  type               TicketEventType
  description        String
  createdAt          DateTime         @default(now())
  ticketGovernance   TicketGovernance @relation(fields: [ticketGovernanceId], references: [id], onDelete: Restrict)
}

model TicketWatcher {
  id                 String           @id @default(uuid())
  ticketGovernanceId String
  userId             String
  role               TicketWatcherRole
  ticketGovernance   TicketGovernance @relation(fields: [ticketGovernanceId], references: [id], onDelete: Restrict)

  @@unique([ticketGovernanceId, userId, role])
}

model Goal {
  id            String       @id @default(uuid())
  title         String
  description   String?
  year          Int
  status        GoalStatus   @default(PLANNED)
  priority      String
  responsibleId String
  projectId     String?
  createdAt     DateTime     @default(now())
  actions       GoalAction[]
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectTasks  ProjectTask[]

  @@index([year, status])
  @@index([projectId])
}

model GoalAction {
  id            String         @id @default(uuid())
  goalId         String
  title          String
  description    String?
  status         GoalActionStatus @default(NOT_STARTED)
  progress       Int            @default(0)
  dueDate        DateTime?
  responsibleId  String
  goal           Goal           @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@index([goalId])
}

model Attachment {
  id              String       @id @default(uuid())
  fileName        String
  mimeType        String
  filePath        String
  measurementId   String?
  glosaId         String?
  projectTaskId   String?
  scheduleId      String?      @map("schedule_id")
  notificationId  String?      @map("notification_id")
  notificationResponseId String? @map("notification_response_id")
  createdAt       DateTime     @default(now())
  measurement     Measurement? @relation(fields: [measurementId], references: [id], onDelete: Restrict)
  glosa           Glosa?       @relation(fields: [glosaId], references: [id], onDelete: Restrict)
  projectTask     ProjectTask? @relation(fields: [projectTaskId], references: [id], onDelete: Cascade)
  schedule        ContractSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  notification    ContractNotification? @relation("NotificationAttachments", fields: [notificationId], references: [id], onDelete: Cascade)
  notificationResponse ContractNotificationResponse? @relation("NotificationResponseAttachments", fields: [notificationResponseId], references: [id], onDelete: Cascade)

  @@index([projectTaskId])
  @@index([scheduleId])
  @@index([notificationId])
  @@index([notificationResponseId])
}

// ---------------------------------------------------------------------------
// Projetos (importação Excel / Monday.com) — independente do Kanban GLPI
// ---------------------------------------------------------------------------

model Project {
  id                  String             @id @default(uuid())
  name                String
  context             String?            @db.Text
  supervisorId        String?
  projectCollectionId String?
  startDate           DateTime?
  plannedEndDate      DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  supervisor          User?              @relation("ProjectSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  projectCollection   ProjectCollection? @relation(fields: [projectCollectionId], references: [id], onDelete: SetNull)
  groups              ProjectGroup[]
  tasks               ProjectTask[]
  goals               Goal[]

  @@index([supervisorId])
  @@index([projectCollectionId])
}

model ProjectCollection {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model ProjectGroup {
  id        String        @id @default(uuid())
  projectId String
  name      String
  sortOrder Int           @default(0)
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     ProjectTask[]

  @@index([projectId, sortOrder])
}

model ProjectTask {
  id                  String    @id @default(uuid())
  projectId           String
  groupId             String
  parentTaskId        String?
  title               String
  status              String    @default("")
  assigneeExternal    String?
  assigneeUserId      String?
  dueDate             DateTime?
  description         String?   @db.Text
  effort              Decimal?  @db.Decimal(18, 4)
  internalResponsible String?
  goalId              String?
  glpiTicketId        Int?
  sortOrder           Int       @default(0)
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group               ProjectGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assigneeUser        User?         @relation("ProjectTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  parent              ProjectTask?  @relation("ProjectTaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Cascade)
  goal                Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  glpiTicket          Ticket?       @relation(fields: [glpiTicketId], references: [glpiTicketId], onDelete: SetNull)
  children            ProjectTask[] @relation("ProjectTaskHierarchy")
  attachments         Attachment[]
  comments            ProjectTaskComment[]
  responsibleUsers    ProjectTaskResponsible[]

  @@index([projectId, groupId])
  @@index([parentTaskId])
  @@index([assigneeUserId])
  @@index([goalId])
  @@index([glpiTicketId])
  @@index([dueDate])
}

model ProjectTaskResponsible {
  taskId    String
  userId    String
  createdAt DateTime    @default(now())
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId, createdAt])
}

model ProjectTaskComment {
  id          String      @id @default(uuid())
  taskId      String
  authorId    String?
  authorEmail String?
  body        String      @db.Text
  createdAt   DateTime    @default(now())
  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User?       @relation("ProjectTaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([authorId, createdAt])
}

// ---------------------------------------------------------------------------
// Cache de sincronização GLPI (Kanban / worker) — mesmo PostgreSQL que o Nest
// ---------------------------------------------------------------------------

/// Chamado sincronizado do GLPI (uma linha por `glpiTicketId`).
model Ticket {
  id                 Int      @id @default(autoincrement())
  /// Identificador do chamado no GLPI.
  glpiTicketId       Int      @unique
  title              String?
  content            String?  @db.Text
  status             String?
  priority           String?
  dateCreation       String?
  dateModification   String?
  contractGroupId    Int?
  contractGroupName  String?
  requesterName      String?
  requesterEmail     String?
  requesterUserId    Int?
  /// Técnico / usuário atribuído no GLPI (`users_id_tech` + nome na equipa quando existir).
  assignedUserId     Int?
  assignedUserName   String?
  /// cliente | empresa | na | unknown — inferido pelo histórico GLPI (cache).
  waitingParty       String?
  rawJson            Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  attributes         TicketAttribute[]
  projectTasks       ProjectTask[]

  @@index([waitingParty])
  @@index([requesterEmail])
  @@index([assignedUserId])
  @@index([status, dateCreation])
  @@index([dateModification])
}


/// Atributo achatado do JSON do ticket (pesquisas e filtros auxiliares).
model TicketAttribute {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  keyPath   String
  valueType String
  valueText String?  @db.Text
  valueJson String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, keyPath])
  @@index([keyPath])
}

/// Chave-valor genérico (cursor de sync, escopo Kanban, etc.).
model SyncState {
  key       String   @id
  value     String?  @db.Text
  updatedAt DateTime @updatedAt
}

/// Órgão (secretaria/unidade) — cadastro central da Administração.
model Organization {
  id                 String     @id @default(uuid())
  name               String
  acronym            String
  code               String?
  active             Boolean    @default(true)
  nameNormalized     String     @unique @map("name_normalized")
  acronymNormalized  String     @unique @map("acronym_normalized")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  users              User[]     @relation("UserPrimaryOrganization")
  userLinks          UserOrganization[]
  usersLastActive    User[]     @relation("UserLastActiveOrganization")
  usersDefault       User[]     @relation("UserDefaultOrganization")
  contracts          Contract[]

  @@map("organization")
}

/// Tipo de contrato (Software, Datacenter…) — substitui lista fixa do enum na UI.
model ContractTypeCatalog {
  id                String     @id @default(uuid())
  name              String
  acronym           String
  description       String?
  active            Boolean    @default(true)
  /// Valor do enum legado correspondente, quando aplicável.
  legacyEnum        ContractType? @map("legacy_enum")
  nameNormalized    String     @unique @map("name_normalized")
  acronymNormalized String     @unique @map("acronym_normalized")
  sortOrder         Int        @default(0) @map("sort_order")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  contracts         Contract[]
  sequenceCounters  ContractInternalCodeSequence[]

  @@map("contract_type_catalog")
}

/// Modalidade/forma de contratação (pregão, dispensa…).
model HiringType {
  id             String     @id @default(uuid())
  name           String
  description    String?
  active         Boolean    @default(true)
  nameNormalized String     @unique @map("name_normalized")
  sortOrder      Int        @default(0) @map("sort_order")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  contracts      Contract[]

  @@map("hiring_type")
}

/// Sequencial anual do código interno por tipo de contrato.
model ContractInternalCodeSequence {
  id                    String              @id @default(uuid())
  contractTypeCatalogId String              @map("contract_type_catalog_id")
  year                  Int
  lastSequential        Int                 @default(0) @map("last_sequential")
  contractTypeCatalog   ContractTypeCatalog @relation(fields: [contractTypeCatalogId], references: [id], onDelete: Cascade)

  @@unique([contractTypeCatalogId, year])
  @@map("contract_internal_code_sequence")
}

/// Tipo padronizado de item de precificação (catálogo Administração).
model ContractItemType {
  id                     String                      @id @default(uuid())
  code                   String                      @unique
  label                  String
  description            String?                     @db.Text
  /// Natureza financeira sugerida para novos itens deste tipo.
  billingKind            ContractPricingBillingKind? @map("billing_kind")
  suggestedUnitId        String?                     @map("suggested_unit_id")
  participatesInGlosa    Boolean                     @default(false) @map("participates_in_glosa")
  useInMeasurements      Boolean                     @default(true) @map("use_in_measurements")
  useInBalanceControl    Boolean                     @default(false) @map("use_in_balance_control")
  useInConsumption       Boolean                     @default(false) @map("use_in_consumption")
  useInFinancialPlanning Boolean                     @default(false) @map("use_in_financial_planning")
  infoOnly               Boolean                     @default(false) @map("info_only")
  active                 Boolean                     @default(true)
  sortOrder              Int                         @default(0) @map("sort_order")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  suggestedUnit          MeasureUnit?                @relation("ItemTypeSuggestedUnit", fields: [suggestedUnitId], references: [id], onDelete: SetNull)
  items                  ContractPricingItem[]

  @@map("contract_item_type")
}

/// Unidade de medida do item de precificação.
model MeasureUnit {
  id        String                @id @default(uuid())
  code      String                @unique
  label     String
  active    Boolean               @default(true)
  sortOrder Int                   @default(0) @map("sort_order")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  items     ContractPricingItem[]
  consumptionItems ContractPricingItem[] @relation("PricingItemConsumptionUnit")
  itemTypes ContractItemType[]    @relation("ItemTypeSuggestedUnit")

  @@map("measure_unit")
}

/// Permissão concedida a um perfil de acesso (base herdada).
model RolePermission {
  id            String        @id @default(uuid())
  /// Papel legado sincronizado com AccessProfile.systemKey (transição).
  role          UserRole
  profileId     String        @map("profile_id")
  permissionKey String        @map("permission_key")
  granted       Boolean       @default(true)
  updatedAt     DateTime      @updatedAt @map("updated_at")
  profile       AccessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, permissionKey])
  @@index([role])
  @@index([profileId])
  @@map("role_permission")
}

/// Permissão adicional concedida a um usuário em um perfil vinculado.
model UserPermission {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  profileId     String        @map("profile_id")
  permissionKey String        @map("permission_key")
  granted       Boolean       @default(true)
  updatedAt     DateTime      @updatedAt @map("updated_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile       AccessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId, permissionKey])
  @@index([userId])
  @@index([profileId])
  @@map("user_permission")
}

/// Item de precificação dinâmica do contrato (mensalidade, horas, UST, equipamentos…).
model ContractPricingItem {
  id                 String                     @id @default(uuid())
  contractId         String                     @map("contract_id")
  sequence           Int
  typeId             String                     @map("type_id")
  description        String                     @db.Text
  unitId             String                     @map("unit_id")
  quantity           Decimal                    @db.Decimal(18, 4)
  unitValue          Decimal                    @map("unit_value") @db.Decimal(18, 4)
  totalValue         Decimal                    @map("total_value") @db.Decimal(18, 2)
  /// Se true, o valor total foi informado manualmente (exige justificativa).
  totalManual        Boolean                    @default(false) @map("total_manual")
  totalJustification String?                    @map("total_justification") @db.Text
  billingKind        ContractPricingBillingKind @map("billing_kind")
  periodicity        ContractPricingPeriodicity?
  periodStart        DateTime?                  @map("period_start")
  periodEnd          DateTime?                  @map("period_end")
  status             ContractPricingItemStatus  @default(ACTIVE)
  /// Se true, este item entra na base de glosa de funcionalidades (mensalidade).
  includeInGlosaBase Boolean                    @default(false) @map("include_in_glosa_base")
  /// Quantidade já consumida/medida (itens sob demanda).
  consumedQuantity   Decimal                    @default(0) @map("consumed_quantity") @db.Decimal(18, 4)
  /// Se true, o item entra no painel/extrato de consumos do contrato.
  consumptionEnabled Boolean                    @default(false) @map("consumption_enabled")
  /// Unidade operacional do consumo (independente da unidade financeira).
  consumptionUnitId  String?                    @map("consumption_unit_id")
  /// Quantidade disponibilizada para controle de consumo (não confundir com quantity financeira).
  consumptionAvailableQuantity Decimal?         @map("consumption_available_quantity") @db.Decimal(18, 4)
  consumptionFinancialRule ConsumptionFinancialRule? @map("consumption_financial_rule")
  consumptionAvailability ConsumptionAvailabilityPeriod? @map("consumption_availability")
  /// Se true, saldo não utilizado acumula para o período seguinte.
  consumptionAccumulates Boolean                @default(false) @map("consumption_accumulates")
  /// Se true, lançamentos exigem aprovação antes de reduzir o saldo definitivo.
  consumptionRequiresValidation Boolean         @default(false) @map("consumption_requires_validation")
  /// Limiares percentuais para alertas de saldo (ex.: [70,80,90,100]).
  consumptionAlertThresholds Json?              @map("consumption_alert_thresholds")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  contract           Contract                   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type               ContractItemType           @relation(fields: [typeId], references: [id])
  unit               MeasureUnit                @relation(fields: [unitId], references: [id])
  consumptionUnit    MeasureUnit?               @relation("PricingItemConsumptionUnit", fields: [consumptionUnitId], references: [id], onDelete: SetNull)
  measurementItems   MeasurementItem[]
  consumptionMovements ContractConsumptionMovement[]
  glosaBaseModules   ContractModule[]           @relation("ContractModuleGlosaPricingItem")
  scheduleLinks      ContractSchedule[]         @relation("ContractSchedulePricingItem")
  scheduleMilestoneLinks ContractScheduleMilestone[] @relation("ContractScheduleMilestonePricingItem")

  @@unique([contractId, sequence])
  @@index([contractId, status])
  @@index([typeId])
  @@index([contractId, consumptionEnabled])
  @@index([consumptionUnitId])
  @@map("contract_pricing_item")
}

/// Lançamento de consumo de item contratual (horas, UST, visitas, etc.).
model ContractConsumptionMovement {
  id                       String                     @id @default(uuid())
  contractId               String                     @map("contract_id")
  pricingItemId            String                     @map("pricing_item_id")
  /// Quantidade efetivamente consumida (reduz saldo após validação/aprovação).
  quantity                 Decimal                    @db.Decimal(18, 4)
  /// Quantidade estimada para planejamento (não reduz saldo definitivo).
  estimatedQuantity        Decimal                    @default(0) @map("estimated_quantity") @db.Decimal(18, 4)
  /// Quantidade originalmente informada (preservada em ajustes).
  originalQuantity         Decimal?                   @map("original_quantity") @db.Decimal(18, 4)
  unitCodeSnapshot         String?                    @map("unit_code_snapshot")
  unitLabelSnapshot        String?                    @map("unit_label_snapshot")
  status                   ConsumptionMovementStatus  @default(INFORMED)
  activityStatus           ConsumptionActivityStatus  @default(SURVEY) @map("activity_status")
  source                   ConsumptionMovementSource  @default(MANUAL)
  glpiTicketId             Int?                       @map("glpi_ticket_id")
  measurementId            String?                    @map("measurement_id")
  measurementItemId        String?                    @map("measurement_item_id")
  executionDate            DateTime                   @map("execution_date")
  startDate                DateTime?                  @map("start_date")
  referencePeriodStart     DateTime?                  @map("reference_period_start")
  referencePeriodEnd       DateTime?                  @map("reference_period_end")
  responsibleLabel         String?                    @map("responsible_label")
  responsibleUserId        String?                    @map("responsible_user_id")
  description              String?                    @db.Text
  notes                    String?                    @db.Text
  rejectionReason          String?                    @map("rejection_reason") @db.Text
  adjustmentJustification  String?                    @map("adjustment_justification") @db.Text
  createdById              String?                    @map("created_by_id")
  validatedById            String?                    @map("validated_by_id")
  validatedAt              DateTime?                  @map("validated_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  contract                 Contract                   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  pricingItem              ContractPricingItem        @relation(fields: [pricingItemId], references: [id], onDelete: Cascade)

  @@index([contractId, status])
  @@index([pricingItemId, status])
  @@index([pricingItemId, activityStatus])
  @@index([glpiTicketId])
  @@index([measurementId])
  @@index([executionDate])
  @@map("contract_consumption_movement")
}

/// Cronograma operacional do contrato (implantação, migração, plano de ação, etc.).
/// Independente de notificações; aprovação operacional não substitui aditivo.
model ContractSchedule {
  id                   String                 @id @default(uuid())
  contractId           String                 @map("contract_id")
  name                 String
  type                 ContractScheduleType
  /// Finalidade / objetivo do cronograma (texto livre).
  purpose              String?                @db.Text
  origin               ContractScheduleOrigin  @default(OUTRO)
  description          String?                @db.Text
  plannedStartDate     DateTime?              @map("planned_start_date")
  plannedEndDate       DateTime?              @map("planned_end_date")
  /// Responsáveis da empresa (nomes livres; usuários externos ainda não existem no cadastro).
  companyResponsibles  String?                @map("company_responsibles") @db.Text
  status               ContractScheduleStatus @default(RASCUNHO)
  version              Int                    @default(1)
  /// Identificador estável da linhagem de versões (igual ao id da 1ª versão).
  lineageId            String                 @map("lineage_id")
  /// Versão que substituiu este registro (quando status = SUBSTITUIDO).
  replacedById         String?                @map("replaced_by_id")
  impactaFinanceiro    Boolean                @default(false) @map("impacta_financeiro")
  pricingItemId        String?                @map("pricing_item_id")
  observations         String?                @db.Text
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  contract      Contract                            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  pricingItem   ContractPricingItem?                @relation("ContractSchedulePricingItem", fields: [pricingItemId], references: [id], onDelete: SetNull)
  replacedBy    ContractSchedule?                   @relation("ContractScheduleReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces      ContractSchedule[]                  @relation("ContractScheduleReplacement")
  responsibles  ContractScheduleInternalResponsible[]
  milestones    ContractScheduleMilestone[]
  attachments   Attachment[]

  @@index([contractId, status])
  @@index([contractId, lineageId, version])
  @@index([pricingItemId])
  @@map("contract_schedule")
}

model ContractScheduleInternalResponsible {
  scheduleId String           @map("schedule_id")
  userId     String           @map("user_id")
  createdAt  DateTime         @default(now()) @map("created_at")
  schedule   ContractSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user       User             @relation("ContractScheduleInternalResponsibleUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([scheduleId, userId])
  @@index([userId])
  @@map("contract_schedule_internal_responsible")
}

/// Etapa ou marco de um cronograma.
model ContractScheduleMilestone {
  id               String                          @id @default(uuid())
  scheduleId       String                          @map("schedule_id")
  sequence         Int
  activity         String
  description      String?                         @db.Text
  pricingItemId    String?                         @map("pricing_item_id")
  featureId        String?                         @map("feature_id")
  plannedStartDate DateTime?                       @map("planned_start_date")
  plannedEndDate   DateTime?                       @map("planned_end_date")
  actualStartDate  DateTime?                       @map("actual_start_date")
  actualEndDate    DateTime?                       @map("actual_end_date")
  percentComplete  Decimal?                        @map("percent_complete") @db.Decimal(5, 2)
  status           ContractScheduleMilestoneStatus  @default(NAO_INICIADA)
  /// Dependências (texto livre ou lista de ids/sequências).
  dependencies     String?                         @db.Text
  observations     String?                         @db.Text
  createdAt        DateTime                        @default(now()) @map("created_at")
  updatedAt        DateTime                        @updatedAt @map("updated_at")

  schedule     ContractSchedule                              @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  pricingItem  ContractPricingItem?                          @relation("ContractScheduleMilestonePricingItem", fields: [pricingItemId], references: [id], onDelete: SetNull)
  feature      ContractFeature?                              @relation(fields: [featureId], references: [id], onDelete: SetNull)
  responsibles ContractScheduleMilestoneInternalResponsible[]

  @@index([scheduleId, sequence])
  @@index([pricingItemId])
  @@index([featureId])
  @@map("contract_schedule_milestone")
}

model ContractScheduleMilestoneInternalResponsible {
  milestoneId String                    @map("milestone_id")
  userId      String                    @map("user_id")
  createdAt   DateTime                  @default(now()) @map("created_at")
  milestone   ContractScheduleMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user        User                      @relation("ContractScheduleMilestoneInternalResponsibleUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([milestoneId, userId])
  @@index([userId])
  @@map("contract_schedule_milestone_internal_responsible")
}

/// Ocorrência contratual (descumprimento, atraso, não conformidade etc.).
/// Sem notificação automática nesta versão; evidências em texto (anexos em onda futura).
model ContractOccurrence {
  id                         String                     @id @default(uuid())
  contractId                 String                     @map("contract_id")
  type                       ContractOccurrenceType
  origin                     ContractOccurrenceOrigin
  title                      String
  description                String?                    @db.Text
  /// Data da constatação.
  detectionDate              DateTime                   @map("detection_date")
  /// IDs opcionais de itens de precificação (JSON string[]).
  linkedPricingItemIds       Json?                      @map("linked_pricing_item_ids")
  linkedFeatureIds           Json?                      @map("linked_feature_ids")
  linkedMeasurementIds       Json?                      @map("linked_measurement_ids")
  linkedGlosaIds             Json?                      @map("linked_glosa_ids")
  linkedScheduleIds          Json?                      @map("linked_schedule_ids")
  severity                   ContractOccurrenceSeverity  @default(MEDIA)
  internalResponsibleUserId  String?                    @map("internal_responsible_user_id")
  regularizationDeadline     DateTime?                  @map("regularization_deadline")
  status                     ContractOccurrenceStatus    @default(EM_ANALISE)
  conclusion                 String?                    @db.Text
  /// Evidências / observações em texto (anexos ficam para onda futura).
  evidenceNotes              String?                    @map("evidence_notes") @db.Text
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")

  contract            Contract                    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  internalResponsible User?                       @relation("ContractOccurrenceInternalResponsible", fields: [internalResponsibleUserId], references: [id], onDelete: SetNull)
  events              ContractOccurrenceEvent[]
  controladoriaCases  ContractControladoriaCase[]

  @@index([contractId, status])
  @@index([contractId, detectionDate])
  @@index([internalResponsibleUserId])
  @@map("contract_occurrence")
}

/// Linha do tempo / histórico de eventos da ocorrência.
model ContractOccurrenceEvent {
  id             String                    @id @default(uuid())
  occurrenceId   String                    @map("occurrence_id")
  /// CREATE | UPDATE | STATUS_CHANGE | FORWARD_CONTROLADORIA | NOTE
  eventType      String                    @map("event_type")
  fromStatus     ContractOccurrenceStatus? @map("from_status")
  toStatus       ContractOccurrenceStatus? @map("to_status")
  justification  String?                   @db.Text
  actorId        String?                   @map("actor_id")
  actorLabel     String?                   @map("actor_label")
  payload        Json?
  createdAt      DateTime                  @default(now()) @map("created_at")

  occurrence ContractOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([occurrenceId, createdAt])
  @@map("contract_occurrence_event")
}

/// Dossiê consolidado encaminhado à Controladoria (não apaga a ocorrência de origem).
model ContractControladoriaCase {
  id               String                          @id @default(uuid())
  contractId       String                          @map("contract_id")
  occurrenceId     String                          @map("occurrence_id")
  status           ContractControladoriaCaseStatus @default(EM_PREPARACAO)
  /// Justificativa do encaminhamento (obrigatória na abertura).
  justification    String                          @db.Text
  /// Resumo do caso.
  summary          String                          @db.Text
  /// Providências sugeridas.
  suggestedActions String?                         @map("suggested_actions") @db.Text
  /// Snapshot consolidado (contrato + ocorrência + vínculos) no momento do encaminhamento.
  snapshotJson     Json                            @map("snapshot_json")
  /// Acompanhamento do processo externo.
  processNumber    String?                         @map("process_number")
  originSystem     String?                         @map("origin_system")
  processLink      String?                         @map("process_link")
  openedAt         DateTime?                       @map("opened_at")
  /// Objeto do processo.
  subject          String?
  /// Unidade responsável.
  unit             String?
  responsiblesText String?                         @map("responsibles_text") @db.Text
  phase            String?
  deadlinesText    String?                         @map("deadlines_text") @db.Text
  decisionsText    String?                         @map("decisions_text") @db.Text
  penaltiesText    String?                         @map("penalties_text") @db.Text
  resultText       String?                         @map("result_text") @db.Text
  /// Campos preparados para integração SEI futura.
  seiNumber        String?                         @map("sei_number")
  seiLink          String?                         @map("sei_link")
  createdAt        DateTime                        @default(now()) @map("created_at")
  updatedAt        DateTime                        @updatedAt @map("updated_at")

  contract   Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  occurrence ContractOccurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)

  @@index([contractId, status])
  @@index([occurrenceId])
  @@index([status, createdAt])
  @@map("contract_controladoria_case")
}

/// Prazo/alerta materializado pelo motor de sync (tickets 49/51/58).
/// Situação aberta é recalculada por dueAt vs agora; conclusões e cancelamentos são preservados no sync.
model Deadline {
  id                String                 @id @default(uuid())
  origin            DeadlineOrigin
  contractId        String?                @map("contract_id")
  title             String
  description       String?                @db.Text
  responsibleUserId String?                @map("responsible_user_id")
  dueAt             DateTime               @map("due_at")
  status            DeadlineStatus         @default(FUTURE)
  attentionLevel    DeadlineAttentionLevel @default(LOW) @map("attention_level")
  expectedAction    String?                @map("expected_action")
  sourceEntityType  String                 @map("source_entity_type")
  sourceEntityId    String                 @map("source_entity_id")
  /// Chave estável para upsert no sync (origin|tipo|id|responsável).
  syncKey           String                 @unique @map("sync_key")
  /// Se true, gerido por syncDeadlines (pode ser atualizado/cancelado automaticamente).
  syncManaged       Boolean                @default(true) @map("sync_managed")
  completedAt       DateTime?              @map("completed_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  responsible User?     @relation("DeadlineResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([origin, status])
  @@index([contractId])
  @@index([responsibleUserId])
  @@index([sourceEntityType, sourceEntityId])
  @@map("deadline")
}

/// Configuração singleton do backup automático para S3 (AWS, MinIO, R2…).
model S3BackupConfig {
  id                 String    @id @default("default")
  enabled            Boolean   @default(false)
  bucket             String    @default("")
  region             String    @default("")
  accessKeyId        String    @default("") @map("access_key_id")
  /// Secret criptografado (AES-256-GCM). Nunca retornado pela API.
  secretAccessKeyEnc String?   @map("secret_access_key_enc") @db.Text
  endpoint           String?
  forcePathStyle     Boolean   @default(true) @map("force_path_style")
  prefix             String    @default("gti/backups")
  /// Hora local do backup diário (0–23). Cron: `0 {hour} * * *`
  hour               Int       @default(3)
  timezone           String    @default("America/Sao_Paulo")
  keepDaily          Int       @default(7) @map("keep_daily")
  keepWeekly         Int       @default(5) @map("keep_weekly")
  keepMonthly        Int       @default(12) @map("keep_monthly")
  /// Marca importação única a partir de variáveis S3_BACKUP_*.
  envImportedAt      DateTime? @map("env_imported_at")
  lastRunAt          DateTime? @map("last_run_at")
  lastRunStatus      String?   @map("last_run_status")
  lastRunError       String?   @map("last_run_error") @db.Text
  lastRunTrigger     String?   @map("last_run_trigger")
  lastRunObjectKey   String?   @map("last_run_object_key")
  lastRunBytes       BigInt?   @map("last_run_bytes")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("s3_backup_config")
}

/// Configuração singleton de e-mail de saída (SMTP) — Administração → Configuração de e-mail.
model EmailOutboundConfig {
  id     String @id @default("default")
  active Boolean @default(false)

  /// NOT_CONFIGURED | CONFIGURED_UNTESTED | TEST_OK | ACTIVE | FAILED
  status String @default("NOT_CONFIGURED")

  smtpHost     String @default("") @map("smtp_host")
  smtpPort     Int    @default(587) @map("smtp_port")
  /// NONE | STARTTLS | SSL_TLS
  security     String @default("STARTTLS")
  authRequired Boolean @default(true) @map("auth_required")
  username     String @default("")
  /// Senha SMTP criptografada (AES-256-GCM). Nunca retornada pela API.
  passwordEnc  String? @map("password_enc") @db.Text

  /// USER_PASS | APP_PASSWORD | OAUTH (OAuth: campos stub)
  authMethod   String  @default("USER_PASS") @map("auth_method")
  oauthClientId     String? @map("oauth_client_id")
  oauthTenantId     String? @map("oauth_tenant_id")
  oauthRefreshTokenEnc String? @map("oauth_refresh_token_enc") @db.Text

  fromName  String @default("") @map("from_name")
  fromEmail String @default("") @map("from_email")
  replyTo   String @default("") @map("reply_to")

  ccDefault         String @default("") @map("cc_default")
  bccDefault        String @default("") @map("bcc_default")
  failureAlertEmail String @default("") @map("failure_alert_email")

  subjectPrefix       String @default("") @map("subject_prefix")
  footerSignature     String @default("") @map("footer_signature") @db.Text
  confidentialityText String @default("") @map("confidentiality_text") @db.Text

  maxAttachmentBytes Int @default(10485760) @map("max_attachment_bytes")
  maxRecipients      Int @default(50) @map("max_recipients")
  retryIntervalSec   Int @default(60) @map("retry_interval_sec")
  maxRetries         Int @default(3) @map("max_retries")

  attachNotificationPdf Boolean @default(false) @map("attach_notification_pdf")
  attachmentsAsLink     Boolean @default(false) @map("attachments_as_link")
  requirePortalAccess   Boolean @default(false) @map("require_portal_access")

  /// Caixa de entrada (stub — desabilitada por padrão).
  inboundEnabled Boolean @default(false) @map("inbound_enabled")
  imapHost       String  @default("") @map("imap_host")
  imapPort       Int     @default(993) @map("imap_port")
  imapSecurity   String  @default("SSL_TLS") @map("imap_security")
  imapUsername   String  @default("") @map("imap_username")
  imapPasswordEnc String? @map("imap_password_enc") @db.Text

  lastTestAt           DateTime? @map("last_test_at")
  lastTestOk           Boolean?  @map("last_test_ok")
  lastTestError        String?   @map("last_test_error") @db.Text
  lastTestRecipient    String?   @map("last_test_recipient")
  activationJustification String? @map("activation_justification") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_outbound_config")
}

/// Histórico mínimo de envios (sem corpo/anexos sensíveis).
model EmailSendLog {
  id           String   @id @default(uuid())
  /// TEST | SYSTEM | NOTIFICATION | OTHER
  type         String
  recipients   String   @db.Text
  /// PENDING | SENT | FAILED
  status       String
  attempts     Int      @default(1)
  errorSummary String?  @map("error_summary") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([type, status])
  @@map("email_send_log")
}

/// Preferências de quais eventos gravar na auditoria (Administração → Auditoria).
model AuditEventConfig {
  id          String   @id @default(uuid())
  moduleKey   String   @map("module_key")
  screenKey   String   @map("screen_key")
  actionKey   String   @map("action_key")
  label       String   @default("")
  moduleLabel String   @default("") @map("module_label")
  enabled     Boolean  @default(true)
  /// ACTION_ONLY | ACTION_AND_VALUES
  detailLevel String   @default("ACTION_AND_VALUES") @map("detail_level")
  /// Se true, sempre habilitado (login, logout, permissões, criar usuário, config de auditoria).
  mandatory   Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([moduleKey, screenKey, actionKey])
  @@index([moduleKey, sortOrder])
  @@map("audit_event_config")
}

/// Política de retenção por categoria (ticket 69). Descarte desligado por padrão (active=false).
model AuditRetentionPolicy {
  id               String   @id @default(uuid())
  categoryKey      String   @unique @map("category_key")
  label            String   @default("")
  /// Dias de retenção após os quais o descarte (se ativo) pode remover logs.
  retentionDays    Int      @map("retention_days")
  /// Piso mínimo (AUTH/SECURITY/PERMISSIONS); a UI e o job não permitem menos.
  minRetentionDays Int      @default(90) @map("min_retention_days")
  /// Se false, o descarte automático/manual desta categoria fica desligado.
  active           Boolean  @default(false)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([active, categoryKey])
  @@map("audit_retention_policy")
}

/// Log de execução de descarte/dry-run (sem regravar conteúdo eliminado).
model AuditRetentionRun {
  id            String   @id @default(uuid())
  /// DRY_RUN | EXECUTE
  mode          String
  /// OK | BLOCKED | FAILED
  status        String
  /// Categorias consideradas (JSON string[]).
  categories    Json
  deletedCount  Int      @default(0) @map("deleted_count")
  previewCount  Int      @default(0) @map("preview_count")
  periodFrom    DateTime? @map("period_from")
  periodTo      DateTime? @map("period_to")
  actorUserId   String?  @map("actor_user_id")
  /// Resumo operacional (contagens por categoria, avisos) — sem oldData/newData dos logs.
  summary       Json?
  errorSummary  String?  @map("error_summary") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_retention_run")
}

/// Classificação contratual local de chamado GLPI (por contrato + ticket).
model ContractGlpiTicketClass {
  id           String                     @id @default(uuid())
  contractId   String                     @map("contract_id")
  glpiTicketId Int                        @map("glpi_ticket_id")
  category     ContractGlpiTicketCategory @default(OUTRO)
  notes        String?                    @db.Text
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, glpiTicketId])
  @@index([contractId])
  @@map("contract_glpi_ticket_class")
}

// ---------------------------------------------------------------------------
// Notificações contratuais (tickets 41–46) e área externa
// ---------------------------------------------------------------------------

/// Modelo reutilizável de notificação (Administração).
model NotificationTemplate {
  id                  String               @id @default(uuid())
  name                String
  documentTitle       String               @map("document_title")
  emailSubject        String               @map("email_subject")
  purpose             NotificationPurpose  @default(OUTRO)
  notificationType    NotificationType     @default(NOTIFICACAO_FORMAL) @map("notification_type")
  severity            NotificationSeverity @default(INFORMATIVA)
  defaultResponseDays Int                  @default(5) @map("default_response_days")
  requiresAck         Boolean              @default(true) @map("requires_ack")
  requiresResponse    Boolean              @default(false) @map("requires_response")
  requiresSchedule    Boolean              @default(false) @map("requires_schedule")
  requiresActionPlan  Boolean              @default(false) @map("requires_action_plan")
  reviewFlow          String?              @map("review_flow")
  active              Boolean              @default(true)
  version             Int                  @default(1)
  bodyHtml            String               @map("body_html") @db.Text
  headerHtml          String?              @map("header_html") @db.Text
  footerHtml          String?              @map("footer_html") @db.Text
  mailMergeFields     Json?                @map("mail_merge_fields")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  versions            NotificationTemplateVersion[]
  notifications       ContractNotification[]

  @@index([active, name])
  @@map("notification_template")
}

/// Snapshot de versão do modelo (quando já usado em notificação).
model NotificationTemplateVersion {
  id           String   @id @default(uuid())
  templateId   String   @map("template_id")
  version      Int
  snapshot     Json
  createdAt    DateTime @default(now()) @map("created_at")
  template     NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId])
  @@map("notification_template_version")
}

/// Sequência anual para numeração NOT-SIGTI-####/AAAA.
model ContractNotificationSequence {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("contract_notification_sequence")
}

/// Notificação formal vinculada a um contrato.
model ContractNotification {
  id                 String                     @id @default(uuid())
  contractId         String                     @map("contract_id")
  templateId         String?                    @map("template_id")
  templateVersion    Int                        @default(1) @map("template_version")
  number             String                     @unique
  status             ContractNotificationStatus @default(RASCUNHO)
  subject            String
  bodyHtml           String                     @map("body_html") @db.Text
  headerHtml         String?                    @map("header_html") @db.Text
  footerHtml         String?                    @map("footer_html") @db.Text
  signedDocumentHtml String?                    @map("signed_document_html") @db.Text
  purpose            NotificationPurpose        @default(OUTRO)
  notificationType   NotificationType           @default(NOTIFICACAO_FORMAL) @map("notification_type")
  severity           NotificationSeverity       @default(INFORMATIVA)
  requiresAck        Boolean                    @default(true) @map("requires_ack")
  requiresResponse   Boolean                    @default(false) @map("requires_response")
  requiresSchedule   Boolean                    @default(false) @map("requires_schedule")
  requiresActionPlan Boolean                    @default(false) @map("requires_action_plan")
  /// Referências de formalização (processo, SEI, etc.) em JSON.
  formalizationRefs  Json?                      @map("formalization_refs")
  ackDeadline        DateTime?                  @map("ack_deadline")
  responseDeadline   DateTime?                  @map("response_deadline")
  effectsStartRule   String?                    @map("effects_start_rule")
  /// Vínculos opcionais: itemIds, featureIds, measurementIds, occurrenceIds, scheduleIds.
  related            Json?
  contentLocked      Boolean                    @default(false) @map("content_locked")
  cancelReason       String?                    @map("cancel_reason") @db.Text
  rectifyReason      String?                    @map("rectify_reason") @db.Text
  parentNotificationId String?                  @map("parent_notification_id")
  ackAt              DateTime?                  @map("ack_at")
  ackByUserId        String?                    @map("ack_by_user_id")
  sentAt             DateTime?                  @map("sent_at")
  createdById        String                     @map("created_by_id")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  contract   Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  template   NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy  User                  @relation("ContractNotificationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  parent     ContractNotification? @relation("NotificationRectification", fields: [parentNotificationId], references: [id], onDelete: SetNull)
  children   ContractNotification[] @relation("NotificationRectification")
  events     ContractNotificationEvent[]
  signers    ContractNotificationSigner[]
  responses  ContractNotificationResponse[]
  attachments Attachment[] @relation("NotificationAttachments")

  @@index([contractId, status])
  @@index([status, createdAt])
  @@index([createdById])
  @@map("contract_notification")
}

model ContractNotificationEvent {
  id             String   @id @default(uuid())
  notificationId String   @map("notification_id")
  eventType      String   @map("event_type")
  fromStatus     String?  @map("from_status")
  toStatus       String?  @map("to_status")
  note           String?  @db.Text
  actorId        String?  @map("actor_id")
  actorLabel     String?  @map("actor_label")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  notification   ContractNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, createdAt])
  @@map("contract_notification_event")
}

model ContractNotificationSigner {
  id               String                   @id @default(uuid())
  notificationId   String                   @map("notification_id")
  userId           String                   @map("user_id")
  order            Int                      @default(1)
  required         Boolean                  @default(true)
  modality         NotificationSignModality @default(PASSWORD)
  signedAt         DateTime?                @map("signed_at")
  signerName       String?                  @map("signer_name")
  signerCpf        String?                  @map("signer_cpf")
  signerJobTitle   String?                  @map("signer_job_title")
  signerOrgLabel   String?                  @map("signer_org_label")
  verificationCode String?                  @map("verification_code")
  createdAt        DateTime                 @default(now()) @map("created_at")
  notification     ContractNotification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user             User                     @relation("ContractNotificationSignerUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([notificationId, userId])
  @@index([notificationId, order])
  @@map("contract_notification_signer")
}

/// Manifestação / resposta da empresa (área externa).
model ContractNotificationResponse {
  id               String   @id @default(uuid())
  notificationId   String   @map("notification_id")
  authorUserId     String   @map("author_user_id")
  bodyText         String   @map("body_text") @db.Text
  /// Status por item relacionado (MVP JSON).
  itemStatuses     Json?    @map("item_statuses")
  draft            Boolean  @default(true)
  submittedAt      DateTime? @map("submitted_at")
  /// Análise interna — NÃO expor a usuários externos.
  analysisStatus   NotificationManifestationAnalysis? @map("analysis_status")
  analysisNote     String?  @map("analysis_note") @db.Text
  analyzedAt       DateTime? @map("analyzed_at")
  analyzedById     String?  @map("analyzed_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  notification     ContractNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  author           User     @relation("ContractNotificationResponseAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  attachments      Attachment[] @relation("NotificationResponseAttachments")

  @@index([notificationId, draft])
  @@map("contract_notification_response")
}
